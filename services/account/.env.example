DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///db.sqlite3
SUPABASE_JWT_SECRET=replace-me-with-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
ALLOW_DEV_AUTH_HEADER=false
ENABLE_API_DOCS=true
